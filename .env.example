# Copy to .env and adjust. Everything is optional — the app runs with defaults.

# PORT=3000
# DATA_DIR=./data

# Public base URL used in password-reset emails (set this once the tunnel URL is known).
# PUBLIC_URL=https://children.thehopebeyondmeasure.org

# SMTP settings for password-reset emails. Without these, reset links are
# printed to the server console instead.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user
# SMTP_PASS=pass
# MAIL_FROM=dashboard@thehopebeyondmeasure.org
