# Copy to .env and adjust. Everything is optional — the app runs with defaults.

# PORT=3000
# DATA_DIR=./data

# Shared password visitors must enter before the children dashboard is shown.
# Leave unset to leave the dashboard open to anyone with the link.
# SITE_PASSWORD=changeme

# Shared password organizers use to create/edit/publish profiles at /admin.
# Required — /admin is unreachable until this is set.
# ADMIN_PASSWORD=changeme-too
