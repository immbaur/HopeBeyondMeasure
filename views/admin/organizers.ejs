<%- include('../partials/head', { title: 'Organizers' }) %>

<section class="section">
  <div class="container narrow">
    <a href="/admin/profiles" class="back-link">← All profiles</a>
    <h1>Organizer accounts</h1>

    <div class="admin-list">
      <% for (const o of organizers) { %>
        <div class="admin-row">
          <div class="admin-row-info">
            <strong><%= o.name %></strong> <span class="muted">· <%= o.email %></span>
            <% if (user.id === o.id) { %><span class="badge badge-published">You</span><% } %>
          </div>
          <div class="admin-row-actions">
            <% if (user.id !== o.id) { %>
              <form method="post" action="/admin/organizers/<%= o.id %>/delete" class="inline-form"
                    onsubmit="return confirm('Remove <%= o.name %>’s organizer account?')">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button type="submit" class="btn btn-small btn-danger">Remove</button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>

    <h2>Add an organizer</h2>
    <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
    <form method="post" action="/admin/organizers" class="stacked-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="form-row">
        <label>Name
          <input type="text" name="name" value="<%= values.name || '' %>" required>
        </label>
        <label>Email address
          <input type="email" name="email" value="<%= values.email || '' %>" required>
        </label>
      </div>
      <label>Temporary password <small>(at least 10 characters — they can change it via “Forgot password”)</small>
        <input type="password" name="password" minlength="10" required>
      </label>
      <button type="submit" class="btn btn-primary">Add organizer</button>
    </form>
  </div>
</section>

<%- include('../partials/foot') %>
