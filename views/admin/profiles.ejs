<%- include('../partials/head', { title: 'Manage profiles' }) %>

<section class="section">
  <div class="container">
    <div class="admin-toolbar">
      <h1>Profiles</h1>
      <div class="admin-toolbar-actions">
        <a href="/admin/organizers" class="btn btn-secondary">Organizers</a>
        <a href="/admin/profiles/new" class="btn btn-primary">+ New profile</a>
      </div>
    </div>

    <% if (profiles.length === 0) { %>
      <div class="empty-state">
        <h2>No profiles yet</h2>
        <p>Create the first child profile — it stays a private draft until you publish it.</p>
        <a href="/admin/profiles/new" class="btn btn-primary">Create the first profile</a>
      </div>
    <% } else { %>
      <div class="admin-list">
        <% for (const p of profiles) { %>
          <div class="admin-row">
            <div class="admin-row-photo">
              <% if (p.cover) { %>
                <img src="/uploads/<%= p.cover %>" alt="" loading="lazy">
              <% } else { %>
                <div class="card-photo-placeholder">💙</div>
              <% } %>
            </div>
            <div class="admin-row-info">
              <strong><%= p.name %></strong><% if (p.age != null) { %>, <%= p.age %><% } %>
              <span class="muted">· <%= p.location %> · <%= p.photo_count %> photo<%= p.photo_count === 1 ? '' : 's' %></span>
              <div>
                <span class="badge badge-<%= p.status %>"><%= p.status === 'published' ? 'Published' : 'Draft' %></span>
                <% if (!p.consent_recorded) { %><span class="badge badge-warn">No consent recorded</span><% } %>
              </div>
            </div>
            <div class="admin-row-actions">
              <a class="btn btn-small btn-secondary" href="/children/<%= p.id %>">View</a>
              <a class="btn btn-small btn-secondary" href="/admin/profiles/<%= p.id %>/edit">Edit</a>
              <% if (p.status === 'published') { %>
                <form method="post" action="/admin/profiles/<%= p.id %>/unpublish" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button type="submit" class="btn btn-small btn-secondary">Unpublish</button>
                </form>
              <% } else { %>
                <form method="post" action="/admin/profiles/<%= p.id %>/publish" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrf %>">
                  <button type="submit" class="btn btn-small btn-primary" <%= p.consent_recorded ? '' : 'disabled title="Record consent first (edit the profile)"' %>>Publish</button>
                </form>
              <% } %>
              <form method="post" action="/admin/profiles/<%= p.id %>/delete" class="inline-form"
                    onsubmit="return confirm('Delete <%= p.name %>’s profile and all photos? This cannot be undone.')">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button type="submit" class="btn btn-small btn-danger">Delete</button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<%- include('../partials/foot') %>
