<%- include('../partials/head', { title: 'Choose a new password' }) %>

<section class="section">
  <div class="container auth-card">
    <h1>Choose a new password</h1>
    <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
    <form method="post" action="/admin/reset/<%= token %>" class="stacked-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>New password <small>(at least 10 characters)</small>
        <input type="password" name="password" minlength="10" required autofocus>
      </label>
      <button type="submit" class="btn btn-primary">Save new password</button>
    </form>
  </div>
</section>

<%- include('../partials/foot') %>
