<%- include('../partials/head', { title: 'First-time setup' }) %>

<section class="section">
  <div class="container auth-card">
    <h1>Welcome! Let’s set up your account</h1>
    <p>Create the first organizer account for this dashboard. You can add more organizers later.</p>
    <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
    <form method="post" action="/admin/setup" class="stacked-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label>Your name
        <input type="text" name="name" value="<%= values.name || '' %>" required autofocus>
      </label>
      <label>Email address
        <input type="email" name="email" value="<%= values.email || '' %>" required>
      </label>
      <label>Password <small>(at least 10 characters)</small>
        <input type="password" name="password" minlength="10" required>
      </label>
      <button type="submit" class="btn btn-primary">Create account</button>
    </form>
  </div>
</section>

<%- include('../partials/foot') %>
