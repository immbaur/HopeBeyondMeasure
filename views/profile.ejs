<%- include('partials/head', { title: profile.name }) %>

<% if (isPreview) { %>
  <div class="container"><div class="flash flash-info">
    Draft preview — this profile is <strong>not</strong> visible to the public yet.
  </div></div>
<% } %>

<section class="section">
  <div class="container">
    <% if (isOrganizer) { %>
      <div class="admin-toolbar">
        <a href="/admin/profiles" class="back-link">← Back to all profiles</a>
        <div class="admin-toolbar-actions">
          <% if (profile.family_income || profile.organizer_notes) { %>
            <div class="view-toggle" data-view-toggle>
              <button type="button" class="view-toggle-btn active" data-view-btn="organizer">Organizer view</button>
              <button type="button" class="view-toggle-btn" data-view-btn="sponsor">Sponsor view</button>
            </div>
          <% } %>
          <a href="/admin/profiles/<%= profile.id %>/edit" class="btn btn-primary">Edit profile</a>
        </div>
      </div>
    <% } else { %>
      <a href="/" class="back-link">← Back to all children</a>
    <% } %>

    <div class="profile-layout">
      <div class="profile-gallery">
        <% if (photos.length > 0) { %>
          <div class="gallery" data-gallery>
            <div class="gallery-main">
              <img src="/uploads/<%= photos[0].filename %>" alt="Photo of <%= profile.name %>" data-gallery-main>
              <% if (photos.length > 1) { %>
                <button class="gallery-nav gallery-prev" type="button" data-gallery-prev aria-label="Previous photo">‹</button>
                <button class="gallery-nav gallery-next" type="button" data-gallery-next aria-label="Next photo">›</button>
              <% } %>
            </div>
            <% if (photos.length > 1) { %>
              <div class="gallery-thumbs">
                <% photos.forEach((ph, i) => { %>
                  <button type="button" class="gallery-thumb <%= i === 0 ? 'active' : '' %>"
                          data-full="/uploads/<%= ph.filename %>" data-index="<%= i %>">
                    <img src="/uploads/<%= ph.thumb_filename %>" alt="" loading="lazy">
                  </button>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <div class="card-photo-placeholder gallery-placeholder">💙</div>
        <% } %>
      </div>

      <div class="profile-details">
        <h1><%= profile.name %><% if (age != null) { %>, <span class="age"><%= age %> years old</span><% } %></h1>
        <p class="profile-location">📍 <%= profile.location %></p>

        <% if (profile.aspiration) { %>
          <blockquote class="serif-quote profile-dream">
            “When I grow up, I want to be <%= profile.aspiration.toLowerCase() %>.”
          </blockquote>
        <% } %>

        <% if (profile.living_situation) { %>
          <div class="detail-block">
            <h2>Their Story</h2>
            <p><%= profile.living_situation %></p>
          </div>
        <% } %>

        <% if (profile.support_note) { %>
          <div class="detail-block">
            <h2>How Your Support Helps</h2>
            <p><%= profile.support_note %></p>
          </div>
        <% } %>

        <div class="sponsor-box">
          <h2>Sponsor <%= profile.name %></h2>
          <p>
            Reach out through our main website and mention <%= profile.name %> from
            <%= profile.location %> — we’ll take it from there.
          </p>
          <a class="btn btn-primary" href="<%= mainSite %>" target="_blank" rel="noopener">Sponsor <%= profile.name %></a>
        </div>
      </div>
    </div>

    <% if (isOrganizer && (profile.family_income || profile.organizer_notes)) { %>
      <div class="organizer-only" data-organizer-only>
        <p class="organizer-only-label">Organizer only — not shown to sponsors</p>
        <div class="organizer-only-fields">
          <% if (profile.family_income) { %>
            <div class="detail-block">
              <h3>Family income</h3>
              <p><%= profile.family_income %></p>
            </div>
          <% } %>
          <% if (profile.organizer_notes) { %>
            <div class="detail-block">
              <h3>Organizer notes</h3>
              <p><%= profile.organizer_notes %></p>
            </div>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
